# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/whatsapp_crm

# Auth Adapter: jwt | session | mock
AUTH_ADAPTER=mock
JWT_SECRET=your-jwt-secret-change-in-production
SESSION_INTROSPECTION_URL=http://localhost:3000/api/auth/me

# Mock auth (development only)
MOCK_USER_ID=user-001
MOCK_TENANT_ID=tenant-001
MOCK_USER_ROLE=ADMIN
MOCK_USER_EMAIL=admin@example.com
MOCK_USER_NAME=Admin User

# Meta WhatsApp Cloud API
META_API_VERSION=v21.0
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Encryption (32-byte hex key for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=whatsapp-crm-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PRESIGNED_URL_EXPIRY=3600

# Calling (Meta-dependent)
CALLING_ENABLED=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
