{
  "name": "whatsapp-crm-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android shell for WhatsApp CRM",
  "scripts": {
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease bundleRelease",
    "android:build": "npm run cap:sync && npm run android:release"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "typescript": "^5.7.3"
  },
  "capacitor": {
    "platforms": [
      "android"
    ]
  }
}
