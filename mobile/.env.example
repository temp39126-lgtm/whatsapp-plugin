# Public HTTPS URL of the deployed WhatsApp CRM frontend (no trailing slash).
# The Android app WebView loads this URL in production/testing builds.
CAPACITOR_SERVER_URL=https://your-domain.example.com

# Release signing (used by scripts/android-release.sh)
KEYSTORE_FILE=release.keystore
KEYSTORE_PASSWORD=change-me
KEY_ALIAS=whatsappcrm
KEY_PASSWORD=change-me
