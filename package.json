{
  "name": "whatsapp-crm-plugin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build:all": "npm run build --prefix backend && npm run build --prefix frontend",
    "test:all": "npm test --prefix backend",
    "check": "bash scripts/check.sh",
    "seed": "npm run seed --prefix backend",
    "seed:demo": "npm run seed:demo --prefix backend",
    "mongo": "bash scripts/start-mongo.sh",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n backend,frontend -c green,blue \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start:all": "npm run mongo && npm run seed --prefix backend && npm run dev",
    "tunnel": "bash scripts/tunnel.sh",
    "mobile:install": "npm install --prefix mobile",
    "mobile:sync": "npm run cap:sync --prefix mobile",
    "mobile:debug": "bash mobile/scripts/build-debug.sh",
    "mobile:release": "bash mobile/scripts/build-release.sh",
    "deploy:secrets": "bash scripts/generate-deploy-secrets.sh",
    "deploy:production": "bash scripts/deploy-production.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
