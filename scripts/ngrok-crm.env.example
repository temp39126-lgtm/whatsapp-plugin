# Copy to scripts/ngrok-crm.env (gitignored via .env pattern) and fill in.
# Reserve two domains in https://dashboard.ngrok.com/domains (paid plan for custom/stable names).
#
# Example reserved hostnames (yours will differ):
#   wapicrm.ngrok.app          -> frontend (port 3000)
#   wapicrm-api.ngrok.app      -> backend  (port 5000)

NGROK_AUTHTOKEN=your-ngrok-authtoken

# Hostname only — no https://
NGROK_CRM_FRONTEND_DOMAIN=your-crm-frontend.ngrok.app
NGROK_CRM_BACKEND_DOMAIN=your-crm-backend.ngrok.app
