# =============================================================================
# Production deployment — copy to deploy/.env and fill in your values
# =============================================================================
# 1. Buy a domain (e.g. crm.yourcompany.com)
# 2. Point DNS A record → your VPS public IP
# 3. Copy this file:  cp deploy/.env.production.example deploy/.env
# 4. Edit deploy/.env (set DOMAIN and passwords)
# 5. Run: bash scripts/deploy-production.sh
# =============================================================================

# Your domain (no https://, no trailing slash)
DOMAIN=crm.yourcompany.com

# Public URL used by the app, API, CORS, and Android APK
APP_URL=https://crm.yourcompany.com

# ---- Secrets (generate with: bash scripts/generate-deploy-secrets.sh) ----
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MongoDB (internal Docker network — change password)
MONGO_ROOT_USER=whatsappcrm
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MinIO / S3-compatible storage (internal)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
S3_BUCKET=whatsapp-crm-media

# Admin account created on first seed
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Meta WhatsApp Cloud API (configure in app Settings after deploy, or set here)
META_VERIFY_TOKEN=your-webhook-verify-token
CALLING_ENABLED=true

# Email (optional — for password reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourcompany.com
